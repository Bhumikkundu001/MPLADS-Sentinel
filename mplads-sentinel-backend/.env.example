# ── Database ──────────────────────────────────────────────────────────
# SQLite (default for demo — change to PostgreSQL for production)
DATABASE_URL=sqlite:///./mplads_sentinel.db
# PostgreSQL example:
# DATABASE_URL=postgresql://user:password@localhost:5432/mplads_sentinel

# ── LLM Provider ──────────────────────────────────────────────────────
# Choose one: "google", "anthropic", "openai", "template"
# "template" requires no API key — uses rule-based responses (good for demo without a key)
LLM_PROVIDER=template

# Google Gemini (free tier — https://aistudio.google.com/app/apikey)
GOOGLE_API_KEY=

# Anthropic Claude
ANTHROPIC_API_KEY=

# OpenAI
OPENAI_API_KEY=

# ── CORS ──────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── App ───────────────────────────────────────────────────────────────
APP_ENV=development
MAX_COPILOT_INPUT_LENGTH=2000
COPILOT_RESULT_LIMIT=10
